---
import PanelSidebar from './PanelSidebar.tsx';

const chips = [
  "What's working in skincare this week?",
  'Has this format peaked?',
  'Write the script for our version.',
  'Analyze why this video did 5M views?',
  'Which hook fits my product?',
];
---
<div class="relative z-20 mx-auto -mt-[92px] w-full max-w-wrap px-7">
  <div class="mx-auto max-w-[980px]">
    <p class="mb-2 flex items-center gap-2 font-mono text-[11px] uppercase tracking-[.14em] text-white [text-shadow:0_1px_8px_rgba(8,16,20,.6)]">
      <span class="h-2 w-2 rounded-full bg-white"></span>EarlyCue agent
    </p>
    <div class="rounded-xl border border-white/40 bg-white/50 p-3 shadow-[0_24px_70px_-18px_rgba(25,30,25,.35)] backdrop-blur-md sm:p-4">
      <div class="flex overflow-hidden rounded-lg border border-line bg-white" id="agentPanel">
        <PanelSidebar />
        <div class="flex min-w-0 flex-1 flex-col">
          <div class="border-b border-line px-5 py-3 text-sm font-medium text-faint">Ask EarlyCue</div>

          <div id="chips" class="flex flex-wrap gap-2 px-5 pb-1 pt-3">
            {chips.map((c, i) => (
              <button class:list={['chip', i === 0 ? 'on' : '']} data-a={i}>{c}</button>
            ))}
          </div>

          <!-- auto-scrolling chat thread -->
          <div id="thread" class="h-[360px] overflow-y-hidden px-5 pt-3 [scrollbar-width:none]"></div>

          <div class="px-5 pb-3.5 pt-2">
            <form id="askForm" class="flex items-center gap-2 rounded-full border border-line px-4 py-1">
              <input class="min-w-0 flex-1 bg-transparent py-1.5 text-[14px] outline-none placeholder:text-faint" type="text" placeholder="Ask EarlyCue anything about your niche..." aria-label="Ask EarlyCue" />
              <button class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-ink text-white" type="submit" aria-label="Send">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </form>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const reels = [
    { src: '/assets/t1.jpg', label: 'street interview' },
    { src: '/assets/t2.jpg', label: 'product demo' },
    { src: '/assets/t3.jpg', label: 'unboxing' },
    { src: '/assets/t4.jpg', label: 'before / after' },
  ];

  const turns = [
    {
      tools: [
        ['scan_reels(niche: "skincare", window: "7d")', '1,284 reels'],
        ['cluster_formats()', '17 formats'],
        ['rank_by_velocity()', 'top 3 accelerating'],
      ],
      a: 'Three formats are accelerating. The fastest: a street-interview hook, first seen 9 days ago, now used by 41 unrelated creators.',
      reels: true,
    },
    {
      tools: [
        ['format_curve("street interview")', 'day 9 of curve'],
        ['compare_cohorts(w-1, w0)', '+1.8x'],
      ],
      a: "Still climbing. This week's videos in it outperform last week's by 1.8x, and no saturation signal yet.",
    },
    {
      tools: [
        ['fetch_top_performers("skincare")', '12 reels'],
        ['extract_structure(hook, body, cta)', '21s template'],
        ['draft_brief()', '4 shots, 2 hooks'],
      ],
      a: 'Draft ready: 4 shots, 2 hook variants, 21 seconds. Built from the top performer in your niche this week.',
    },
    {
      tools: [
        ['fetch_video(url)', '5.0M views'],
        ['decompose_frames()', 'hook 0:00-0:03'],
        ['compare_to_creator_median()', '38x baseline'],
      ],
      a: "It's the hook: a POV question in the first 3 seconds. The video runs 38x this creator's own median, so the format did the work, not the account.",
    },
    {
      tools: [
        ['embed_product_profile()', 'profile ready'],
        ['search_hooks(sim > 0.8)', '23 matches'],
        ['score_transferability()', 'top 5 ranked'],
      ],
      a: 'Five hooks transfer to your product. Best fit: the street-interview POV question, already proven in 3 adjacent niches.',
    },
  ];

  const thread = document.getElementById('thread');
  const chipEls = [...document.querySelectorAll('#chips .chip')];
  let run = 0; // playback token: bump to cancel an in-flight run

  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  const scrollDown = () => thread.scrollTo({ top: thread.scrollHeight, behavior: reduce ? 'auto' : 'smooth' });

  function el(html) {
    const t = document.createElement('template');
    t.innerHTML = html.trim();
    return t.content.firstChild;
  }

  const checkSvg =
    '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#141412" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
  const pendingDot = '<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-faint"></span>';

  function toolRow([call, result], done) {
    return el(`<div class="flex items-center gap-2.5 py-[3px] font-mono text-[11.5px]">
      <span class="flex h-3 w-3 flex-none items-center justify-center">${done ? checkSvg : pendingDot}</span>
      <span class="truncate text-body">${call}</span>
      <span class="ml-auto flex-none pl-3 text-faint">${done ? result : ''}</span>
    </div>`);
  }

  function userBubble(text) {
    return el(`<div class="flex items-start justify-end gap-2.5 pt-1">
      <p class="max-w-[75%] rounded-xl bg-tint3 px-3 py-1.5 text-[14px] text-ink">${text}</p>
      <span class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full bg-tint3 text-[9px] font-bold text-body">You</span>
    </div>`);
  }

  function agentShell() {
    return el(`<div class="mt-3 flex items-start gap-2.5 pb-4">
      <span class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full bg-ink text-[10px] font-bold text-white">E</span>
      <div class="min-w-0 flex-1">
        <p class="text-[12.5px] font-semibold">EarlyCue agent</p>
        <div class="tools mt-1.5 border-l border-line pl-3"></div>
        <p class="ans mt-2 text-[14px] text-ink"></p>
      </div>
    </div>`);
  }

  function reelsBlock() {
    return el(`<div class="mt-2.5">
      <p class="mb-1.5 text-[11.5px] text-faint">Reels behind this call</p>
      <div class="grid grid-cols-4 gap-2 max-w-[440px]">${reels
        .map(
          (r) => `<figure class="m-0">
            <img class="block w-full rounded-lg object-cover [aspect-ratio:9/16]" src="${r.src}" alt="${r.label} reel still" loading="lazy">
            <figcaption class="mt-1 font-mono text-[9.5px] text-faint">${r.label}</figcaption>
          </figure>`
        )
        .join('')}</div>
    </div>`);
  }

  async function playTurn(i, token) {
    const t = turns[i];
    chipEls.forEach((c) => c.classList.remove('on'));
    chipEls[i].classList.add('on');

    thread.appendChild(userBubble(chipEls[i].textContent));
    const shell = agentShell();
    thread.appendChild(shell);
    scrollDown();
    const toolsBox = shell.querySelector('.tools');
    const ans = shell.querySelector('.ans');

    for (const spec of t.tools) {
      if (token !== run) return;
      const pending = toolRow(spec, false);
      toolsBox.appendChild(pending);
      scrollDown();
      if (!reduce) await sleep(420);
      pending.replaceWith(toolRow(spec, true));
    }

    if (!reduce) await sleep(260);
    if (reduce) {
      ans.textContent = t.a;
    } else {
      for (let n = 0; n <= t.a.length; n += 2) {
        if (token !== run) return;
        ans.textContent = t.a.slice(0, n);
        if (n % 24 === 0) scrollDown();
        await sleep(14);
      }
      ans.textContent = t.a;
    }
    if (t.reels) {
      shell.querySelector('.min-w-0').appendChild(reelsBlock());
    }
    scrollDown();
  }

  async function playFrom(start) {
    const token = ++run;
    thread.innerHTML = '';
    let i = start;
    while (token === run) {
      await playTurn(i, token);
      if (token !== run) return;
      if (!reduce) await sleep(1400);
      i = (i + 1) % turns.length;
      if (i === 0 && token === run) thread.innerHTML = '';
    }
  }

  document.getElementById('chips').addEventListener('click', (e) => {
    const b = e.target.closest('.chip');
    if (!b) return;
    playFrom(+b.dataset.a);
  });

  document.getElementById('askForm').addEventListener('submit', (e) => e.preventDefault());

  playFrom(0);
</script>
