---
const BOOKING_LINK = 'BOOKING_LINK'; // TODO: replace with the real call-booking URL
---
<section id="call" class="relative overflow-hidden bg-cover bg-center px-7 py-[110px] text-center" style="background-image:url('/assets/cta-beach.jpg')">
  <div class="absolute inset-0" style="background:rgba(10,18,24,.42)" aria-hidden="true"></div>
  <div class="relative">
    <h2 class="rv text-white [text-shadow:0_2px_20px_rgba(5,8,18,.5)] text-[clamp(2rem,4.2vw,3.2rem)]">Be early. It's the whole point.</h2>
    <p class="rv mt-3 text-[1.15rem] font-medium text-white/90 [text-shadow:0_1px_10px_rgba(5,8,18,.5)]">
      If choosing what to shoot is your bottleneck, let's talk.
    </p>
    <div class="rv mt-7 flex justify-center">
      <a class="btn btn-big" href={BOOKING_LINK}>Book a call</a>
    </div>
  </div>
</section>
