---
const stats = [
  { k: 'views', v: '2.1M' },
  { k: 'likes', v: '184K' },
  { k: 'shares', v: '39K' },
  { k: 'vs median', v: '38x' },
];
const arc = [
  { n: 1, b: 'Hook', s: "a question strangers can't dodge" },
  { n: 2, b: 'Setup', s: 'stakes raised fast' },
  { n: 3, b: 'Payoff', s: 'the answer lands' },
  { n: 4, b: 'CTA', s: 'comment-bait loop' },
];
const trending = [
  { src: '/assets/t1.jpg', alt: 'Street interview reel', mult: '41x', cap: '41 creators', tail: 'on this format' },
  { src: '/assets/t2.jpg', alt: 'Product demo reel', mult: '23x', cap: '23 videos', tail: 'with this hook' },
  { src: '/assets/t3.jpg', alt: 'Unboxing reel', mult: '12x', cap: '12 videos', tail: 'with this setup' },
];
---
<section class="bg-tint py-16">
  <div class="mx-auto w-full max-w-wrap px-7">
    <div class="sec-head rv mb-[34px] max-w-[680px]">
      <h2>Break down what made it work.</h2>
      <p class="mt-2.5 max-w-[55ch] text-[1.06rem] text-body">
        Every call comes with the anatomy of the format, and how far it has already spread.
      </p>
    </div>
    <div class="grid items-stretch gap-4 md:grid-cols-2">
      <div class="rv flex flex-col rounded-2xl border border-line bg-white p-6">
        <div class="grid grid-cols-4 gap-2">
          {stats.map((s) => (
            <div class="rounded-[10px] border border-line px-3 py-2.5">
              <div class="font-mono text-[9.5px] uppercase tracking-[.06em] text-faint">{s.k}</div>
              <div class="mt-0.5 text-[1.05rem] font-bold">{s.v}</div>
            </div>
          ))}
        </div>
        <div class="mt-2 grid grid-cols-2 gap-2">
          <div class="rounded-[10px] border border-line px-3 py-2.5">
            <div class="font-mono text-[9.5px] uppercase tracking-[.06em] text-faint">format</div>
            <div class="mt-0.5 text-[.95rem] font-semibold">Street interview</div>
          </div>
          <div class="rounded-[10px] border border-line px-3 py-2.5">
            <div class="font-mono text-[9.5px] uppercase tracking-[.06em] text-faint">hook type</div>
            <div class="mt-0.5 text-[.95rem] font-semibold">POV question</div>
          </div>
        </div>
        <div class="mt-3.5 rounded-[10px] border border-line bg-tint2 p-3.5">
          <div class="font-mono text-[9.5px] uppercase tracking-[.06em] text-faint">story arc</div>
          <div class="mt-2.5 grid grid-cols-4 gap-2.5">
            {arc.map((a) => (
              <div>
                <div class="mb-1.5 flex h-[22px] w-[22px] items-center justify-center rounded-full bg-tint3 font-mono text-[11px]">{a.n}</div>
                <b class="block text-[.88rem]">{a.b}</b>
                <span class="mt-0.5 block text-[.78rem] leading-[1.35] text-faint">{a.s}</span>
              </div>
            ))}
          </div>
        </div>
        <h3 class="mt-[18px] text-[1.2rem]">The anatomy of every reel</h3>
        <p class="mt-1.5 text-[.95rem] text-body">
          Hook, structure, and pacing extracted frame by frame, so you know exactly what to replicate and what to swap for your product.
        </p>
      </div>
      <div class="rv flex flex-col rounded-2xl border border-line bg-white p-6">
        <span class="inline-flex items-center gap-2 self-start rounded-full border border-line px-3.5 py-1.5 font-mono text-[11px] tracking-[.08em] text-body">
          <i class="h-2 w-2 rounded-full bg-ink not-italic"></i>TRENDING NOW
        </span>
        <div class="mt-3.5 grid grid-cols-3 gap-2.5">
          {trending.map((t) => (
            <figure class="relative m-0">
              <img class="block w-full rounded-[10px] object-cover [aspect-ratio:9/16]" src={t.src} alt={t.alt} loading="lazy" />
              <span class="absolute right-2 top-2 rounded-md bg-ink px-2 py-[3px] font-mono text-[11px] text-white">{t.mult}</span>
              <figcaption class="mt-1.5 text-[.8rem] text-body"><b class="font-bold">{t.cap}</b> {t.tail}</figcaption>
            </figure>
          ))}
        </div>
        <h3 class="mt-[18px] text-[1.2rem]">Spread, measured live</h3>
        <p class="mt-1.5 text-[.95rem] text-body">
          Follow a hook or format across unrelated creators and niches. See where a pattern is repeating, and move before it peaks.
        </p>
      </div>
    </div>
    <p class="mt-4 text-[.9rem] text-faint">Sample data. Live calls ship with the actual reels and their numbers.</p>
  </div>
</section>
