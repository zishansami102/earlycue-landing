---
const rowA = [
  'Street interview', 'Spokesperson', 'Testimonial', 'Product demo', 'Founder story',
  'Before and after', 'Unboxing', 'Voiceover b-roll',
];
const rowB = [
  'Skit', 'Tutorial', 'Green screen react', 'Day in the life', 'Offer-first',
  'Studio shot', 'Duet reply', 'POV challenge',
];
---
<section class="overflow-hidden pb-3 pt-9" aria-label="Format types EarlyCue labels">
  <p class="mb-5 text-center font-mono text-[11px] uppercase tracking-[.14em] text-faint">
    Every reel we track gets decomposed and labelled by format
  </p>
  <div class="flex flex-col gap-2.5 [mask-image:linear-gradient(90deg,transparent,#000_10%,#000_90%,transparent)]">
    <div class="marq flex w-max gap-2.5 hover:[animation-play-state:paused]">
      {[...rowA, ...rowA].map((f, i) => (
        <span class:list={[
          'whitespace-nowrap rounded-full px-4 py-[7px] text-[.9rem]',
          i % 3 === 1 ? 'bg-tint3 text-ink' : 'border border-line bg-white text-body',
        ]}>{f}</span>
      ))}
    </div>
    <div class="marq marq-rev flex w-max gap-2.5 hover:[animation-play-state:paused]">
      {[...rowB, ...rowB].map((f, i) => (
        <span class:list={[
          'whitespace-nowrap rounded-full px-4 py-[7px] text-[.9rem]',
          i % 3 === 2 ? 'bg-tint3 text-ink' : 'border border-line bg-white text-body',
        ]}>{f}</span>
      ))}
    </div>
  </div>
</section>
