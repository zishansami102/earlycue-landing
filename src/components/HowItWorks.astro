---
const steps = [
  {
    title: 'Track thousands of fresh reels, every hour',
    body: "Across your niche on Instagram and TikTok, recording how every video's numbers move over time.",
  },
  {
    title: 'Break each one down, frame by frame',
    body: 'Overperforming videos get decomposed into hook, body and CTA, then labelled into comparable formats.',
  },
  {
    title: 'Deliver the call, and the brief',
    body: 'Which format is rising, whether it fits your product, and the script and shot list to go shoot it.',
  },
];
---
<section id="how" class="bg-tint py-16">
  <div class="mx-auto w-full max-w-wrap px-7">
    <div class="sec-head rv mb-[34px] max-w-[680px]">
      <h2>It doomscrolls at scale, so you don't have to.</h2>
      <p class="mt-2.5 max-w-[55ch] text-[1.06rem] text-body">While you sleep, three systems keep watching.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((s) => (
        <div class="rv overflow-hidden rounded-xl bg-white shadow-[0_18px_44px_-20px_rgba(25,30,25,.15)] transition hover:-translate-y-[3px] hover:shadow-[0_18px_44px_-20px_rgba(25,30,25,.25)]">
          <div class="px-[22px] pb-[22px] pt-[18px]">
            <h3 class="mb-1.5 text-[1.12rem]">{s.title}</h3>
            <p class="text-[.95rem] text-body">{s.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
